import feria.*

describe "feria" {

	//los municipios se necesitan en la segunda parte
	const sanMartin= new Municipio() //es un municipio normal
	const quilmes = new MunicipioRelajado() //es un municipio relajado
	const tigre = new MunicipioHiperRelajado()	//un municipio hiperrelajado
	
	//Remedios es una visitante de  72 tiene 500 pesos disponible. 
	//Para el punto 2: su deuda es de 700 y reside en tigre	
	const remedios = new Visitante(edad=72, municipio=tigre, dinero=500, deuda=700)
	// Manuel es un visitante de 7 años y tiene 30 pesos, 
	//Par el punto 2: no tiene deuda (es 0) y reside en quilmes
	const manuel = new Visitante(edad=7, municipio=quilmes, dinero=30, deuda =0) 
	
	//Martin es una visitante de 16 años y tiene 120 pesos .
	//Para el punto 2: tiene 80 de deuda y reside en San martin
	const martin = new Visitante(edad=16 ,municipio=sanMartin, dinero=120, deuda=80)	
	
	const arte = new PuestoInfantil(municipio=sanMartin) //Un puesto infantil, para la segunda parte su municipio es San Martin
	const dardos = new PuestoComercial(costo=50, municipio=sanMartin) //un puesto comercial de costo 50, para la segunda parte el municipio es San Martín

	const feriaAzurduy = new Feria(puestos=#{arte, dardos }) // una feria con los puetos de arte y dardos 
	
	const puestoTigre = new Impositivo(municipio=tigre)//un puesto impositivo de tigre 
	const puestoSanMartin = new Impositivo(municipio=sanMartin)//un puesto impositivo de san Martin
	const puestoQuilmes = new Impositivo(municipio=quilmes) //un puesto impositivo de quilmes
	
	
	test "1.1.a se puede visitar?" {
		assert.notThat(arte.puedeUsar(remedios)) //asegurarse que arte NO puede ser usado por remedios
		assert.that(arte.puedeUsar(manuel)) //asegurarse que arte puede ser usado por manuel
		assert.that(arte.puedeUsar(martin)) //asegurarse que arte puede ser usado por martin
		assert.that(dardos.puedeUsar(remedios)) //asegurarse que dardos puede ser usado por remedios
		assert.notThat(dardos.puedeUsar(manuel)) //asegurarse que dardos NO puede ser usado por manuel
		assert.that(dardos.puedeUsar(martin)) //asegurarse que dardos puede ser usado por martin
	}
		
	test "1.1.b saber puestos visitables" {
		assert.equals(#{dardos}, feriaAzurduy.todosLosPuestosVisitables(remedios)) //asegurarse que dardos es el unico puesto que puede usar remedios en la feria azurduy
		assert.equals(#{arte}, feriaAzurduy.todosLosPuestosVisitables(manuel)) //asegurarse que arte es el unico puesto que puede usar manuel en la feria azurduy
		assert.equals(#{arte, dardos}, feriaAzurduy.todosLosPuestosVisitables(martin)) //asegurarse que dardos y arte son los puestos que puede martin en la feria azurduy
	}
	
	test "1.2.a efectos de usar" {
		dardos.usar(remedios) //hacer que el puesto de dardos sea usado por remedios
		assert.throwsException({arte.usar(remedios)}) //el puesto de arte NO debe poder ser usado por remedios
		assert.throwsException({dardos.usar(manuel)}) //el puesto de dardos NO debe poder ser usado por manuel
		arte.usar(manuel) //hacer que el puesto de arte sea usado por manuel
		dardos.usar(martin) //hacer que el puesto de dardos sea usado por martin
		arte.usar(martin) //hacer que el puesto de arte sea usado por martin
		
		assert.equals(450, remedios.dinero()) //comprobar que el dinero de remedios es 450
		assert.equals(40, manuel.dinero()) //comprobar que el dinero de manuel es 40
		assert.equals(80, martin.dinero()) //comprobar que el dinero de martín es 80
		assert.equals(#{martin, manuel}, arte.visitantes()) //comprobar que el puesto de arte fue usado por martin y manuel
		assert.equals(#{martin, remedios}, dardos.visitantes()) //comprobar que el puesto de dardos fue usado por remedios y martin
	}
	
	test "1.2.b saber si se usó o no la feria" {
		dardos.usar(remedios) //hacer que el puesto de dardos sea usado por remedios
		assert.throwsException({dardos.usar(manuel)}) //hacer que el puesto de dardos sea usado por manuel (NO SE PUEDE!)
		assert.that(feriaAzurduy.uso(remedios)) //revisar que remedios usó la feria azurduy
		assert.notThat(feriaAzurduy.uso(manuel)) //revisar que manuel NO usó la feria azurduy
		assert.notThat(feriaAzurduy.uso(martin)) //revisar que martin NO uso la feria azurduy
 	}
 	
 	test "2.1 monto exigible y puestos municipales visitables" {
		assert.equals(80, sanMartin.montoExigible(martin)) //verificar que 80 es el monto que san martin le exige a martin
		assert.that(puestoSanMartin.puedeUsar(martin)) //verificar que puestoSanMartin puede ser usado por martin
		assert.notThat(puestoTigre.puedeUsar(martin)) //verificar que puestoTigre NO puede ser usado por martin
		assert.notThat(puestoQuilmes.puedeUsar(martin)) //verificar que puestoQuilmes NO puede ser usado por martin

 		assert.equals(0, quilmes.montoExigible(manuel)) //verificar que 0 es el monto que quilmes le exige a manuel
 		assert.notThat(puestoSanMartin.puedeUsar(manuel)) //verificar que puestoSanMartin NO puede ser usado por manuel
 		assert.notThat(puestoTigre.puedeUsar(manuel)) //verificar que puestoTigre NO puede ser usado por manuel
 		assert.notThat(puestoQuilmes.puedeUsar(manuel)) //verificar que puestoQuilmes NO puede ser usado por manuel
 		
 		assert.equals(320, tigre.montoExigible(remedios)) //verificar que 320 es el monto que tigre le exige a remedios
 		assert.that(puestoTigre.puedeUsar(remedios)) //verificar que puestoTigre puede ser usado por remedios
 		assert.notThat(puestoSanMartin.puedeUsar(remedios)) //verificar que puestoSanMartin NO puede ser usado por remedios
 		assert.notThat(puestoQuilmes.puedeUsar(remedios)) //verificar que puestoQuilmes NO puede ser usado por remedios
 		
 		remedios.municipio(sanMartin) //hacer que remedios resida en san martin
 		assert.equals(700, sanMartin.montoExigible(remedios)) //verificar que 700 es el monto que san martin le exige a remedios
 		assert.notThat(puestoSanMartin.puedeUsar(remedios)) //verificar que puestoSanMartin NO puede ser usado por remedios
 		
 		remedios.municipio(quilmes) //hacer que remedios resida en quilmes
 		assert.equals(500, quilmes.montoExigible(remedios)) //verificar que 500 es el monto que quilmes le exige a remedios
 		assert.that(puestoQuilmes.puedeUsar(remedios)) //verificar que puestoQuilmes puede ser usado por remedios

 		remedios.edad(80) //hacer que remedios tenga 80 años
 		assert.equals(450, quilmes.montoExigible(remedios)) //verificar que 450 es el monto que quilmes le exige a remedios
 		assert.that(puestoQuilmes.puedeUsar(remedios)) //verificar que puestoQuilmes puede ser usado por remedios
 	}
 	
 	test "2.2 usar puestos impositivos y consultas de municipio" {
 		feriaAzurduy.agregar(puestoTigre) //agregar puestoTigre a la feriaAzurduy
 		feriaAzurduy.agregar(puestoSanMartin) //agregar puestoSanMartin a la feriaAzurduy
 		const juana = new Visitante(edad=20, municipio=sanMartin, dinero=1000, deuda=300) //una visitante que reside en San Martín, tiene 20 años, 1000 pesos y una deuda de 300
 		puestoTigre.usar(remedios) //hacer que el puesto impositivo de Tigre sea usado por Remedios
 		puestoSanMartin.usar(juana) //hacer que el puesto impositivo de San Martín sea usado por Juana
 		puestoSanMartin.usar(martin) //hacer que el puesto impositivo de San Martín sea usado por Martín
 		assert.equals(0, martin.deuda()) //Verificar que Martín no tiene más deuda
 		assert.equals(40, martin.dinero()) //Verificar que Martín tiene 40 de dinero
 		assert.equals(0, juana.deuda()) //Verificar que Juana no tiene más deuda
 		assert.equals(700, juana.dinero()) //Verificar que a Juana le queda 700 de dinero
 		assert.equals(380, remedios.deuda()) //Verificar que Remedios tiene 380 de deuda
 		assert.equals(180, remedios.dinero()) //Verificar que Remedios tiene 180 de dinero
 		assert.equals(320, tigre.recaudacion()) //Verificar que Tigre recaudó 320
 		assert.equals(380, sanMartin.recaudacion()) //Verificar que San Martín recaudó 380
 		assert.equals(1, feriaAzurduy.cuantosApadrina(tigre)) //Verificar que Tigre apadrina 1 puesto de la feria Azurduy
 		assert.equals(3, feriaAzurduy.cuantosApadrina(sanMartin)) //Verificar que San Martín apadrina 3 puestos de la feria Azurduy
 		assert.equals(0, feriaAzurduy.cuantosApadrina(quilmes)) //Verificar que Quilmes no apadrina a nadie en la feria Azurduy
 		assert.equals(#{tigre, sanMartin}, feriaAzurduy.municipios()) //Verificar que los municipios apadrinantes de la feria Azurduy son Tigre y San Martín
 		assert.equals(350, feriaAzurduy.promedioRecaudacion()) //Verificar que el promedio de recaudación de la feria Azurduy es 350
 		assert.equals(tigre, feriaAzurduy.menosRecaudador()) //Verificar que el municipio que menos recaudó en la feria es Tigre
 	}
}
